PORT=3001
DB_PATH=./data/liana.db

# رو سرورِ واقعی حتماً باید باشه. بدونِ این خط سرور فکر می‌کنه تو حالتِ تستِ لوکاله:
# کوکی‌ها Secure نمی‌شن و رفتارهایِ مخصوصِ تست (مثلِ نشون‌دادنِ کدِ ورود رو صفحه) روشن می‌مونن.
# رو لپ‌تاپِ خودت برایِ توسعه این خط رو کامنت نگه دار.
# NODE_ENV=production

# دامنه‌ای که کوکیِ ورودِ مشتری روش ست می‌شه (فقط تو production استفاده می‌شه)
CUSTOMER_COOKIE_DOMAIN_NAME=beautyliana.ir

# دامنه‌هایی که اجازه دارن API رو با کوکی صدا بزنن (فقط production). خالی = پیش‌فرضِ دامنه‌هایِ beautyliana.ir
# CORS_ORIGINS=https://beautyliana.ir,https://www.beautyliana.ir,https://card.beautyliana.ir,https://panel.beautyliana.ir
